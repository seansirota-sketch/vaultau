# Firebase Admin service account JSON (keep the real value in .env / Netlify UI only)
FIREBASE_SERVICE_ACCOUNT=

# Morning OAuth client credentials
MORNING_API_KEY=
MORNING_API_SECRET=

# Use the sandbox URL during integration and the production URL when live
MORNING_API_BASE_URL=https://sandbox.d.greeninvoice.co.il/api/v1
# Optional override; inferred from MORNING_API_BASE_URL when omitted
MORNING_TOKEN_URL=https://api.sandbox.morning.dev/idp/v1/oauth/token

# Secret configured on the Morning payment/received webhook
MORNING_WEBHOOK_SECRET=

# Canonical browser origin used for Morning success and failure redirects
MORNING_APP_URL=https://vaultau.netlify.app
